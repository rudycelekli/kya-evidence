{
  "name": "kya-evidence",
  "version": "0.1.0-alpha.3",
  "description": "Know Your Agent: signed evidence, replayable assurance dossiers and frozen evaluator-control benchmarks.",
  "keywords": ["know-your-agent", "agent-assurance", "agent-evaluation", "evidence", "reproducibility", "conformance"],
  "type": "module",
  "engines": { "node": ">=22" },
  "license": "Apache-2.0",
  "bin": { "kya": "bin/kya.mjs" },
  "exports": { ".": { "types": "./src/index.d.ts", "import": "./src/index.mjs" }, "./conformance": { "types": "./src/conformance/index.d.ts", "import": "./src/conformance/index.mjs" }, "./conformance-report": { "types": "./src/conformance-report/index.d.ts", "import": "./src/conformance-report/index.mjs" }, "./suites": { "types": "./src/suites/index.d.ts", "import": "./src/suites/index.mjs" }, "./holdout": { "types": "./src/holdout/index.d.ts", "import": "./src/holdout/index.mjs" }, "./campaign": { "import": "./src/campaign/index.mjs" }, "./vc-bridge": { "import": "./src/vc-bridge/index.mjs" }, "./assessor": { "import": "./src/assessor/index.mjs" }, "./schemas/*": "./schemas/*" },
  "files": ["bin/", "src/", "suites/", "action/", "policies/", "schemas/", "profiles/", "examples/", "scripts/", "test/", "interop/", "dashboard/", "assets/", "docs/", "evidence/", "AGENTS.md", "PRODUCT.md", "DESIGN.md", "README.md", "CONTRIBUTING.md", "SECURITY.md", "LICENSE", "NOTICE"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node bin/kya.mjs demo",
    "benchmark": "node bin/kya.mjs benchmark",
    "probe": "node bin/kya.mjs probe",
    "dashboard": "node scripts/serve.mjs",
    "pack": "node scripts/pack.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:mutations": "node scripts/mutation-check.mjs",
    "requirements": "node scripts/requirements.mjs",
    "adr:index": "node scripts/adr-index.mjs",
    "sbom": "node scripts/sbom.mjs",
    "privacy:scan": "node scripts/privacy-scan.mjs examples test/fixtures profiles policies suites",
    "privacy:scan:vectors": "node scripts/privacy-scan.mjs --rules pii evidence interop schemas",
    "profiles:registry": "node scripts/profile-registry.mjs",
    "profiles:registry:check": "node scripts/profile-registry.mjs --check",
    "vectors:assessment": "node scripts/assessment-vectors.mjs",
    "vectors:assessment:check": "node scripts/assessment-vectors.mjs --check",
    "vectors:run": "node scripts/run-vectors.mjs",
    "conformance-report": "node scripts/conformance-report.mjs",
    "campaign": "node scripts/kya-campaign.mjs",
    "check:agent": "node scripts/kya-check.mjs",
    "policy:init": "node scripts/kya-policy-init.mjs"
  }
}
