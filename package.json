{
  "name": "kya-evidence",
  "version": "0.1.0-alpha.1",
  "description": "Know Your Agent: scope-bound, verifiable agent evidence and explainable assurance assessments.",
  "type": "module",
  "engines": { "node": ">=22" },
  "license": "Apache-2.0",
  "bin": { "kya": "bin/kya.mjs" },
  "exports": { ".": { "types": "./src/index.d.ts", "import": "./src/index.mjs" }, "./conformance": "./src/conformance/index.mjs", "./schemas/*": "./schemas/*" },
  "files": ["bin/", "src/", "schemas/", "profiles/", "examples/", "README.md", "LICENSE", "NOTICE", "docs/SPECIFICATION.md", "docs/SCORING.md", "docs/THREAT-MODEL.md"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node bin/kya.mjs demo",
    "benchmark": "node bin/kya.mjs benchmark",
    "probe": "node bin/kya.mjs probe",
    "dashboard": "node scripts/serve.mjs",
    "pack": "node scripts/pack.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "adr:index": "node scripts/adr-index.mjs"
  }
}
