{
  "name": "kya-evidence",
  "version": "0.1.0-alpha.3",
  "description": "Know Your Agent: Portable agent assurance: signed evidence, replay-supported diagnostics and frozen evaluator-control benchmarks.",
  "type": "module",
  "engines": { "node": ">=22" },
  "license": "Apache-2.0",
  "bin": { "kya": "bin/kya.mjs" },
  "exports": { ".": { "types": "./src/index.d.ts", "import": "./src/index.mjs" }, "./conformance": { "types": "./src/conformance/index.d.ts", "import": "./src/conformance/index.mjs" }, "./schemas/*": "./schemas/*" },
  "files": ["bin/", "src/", "schemas/", "profiles/", "examples/", "scripts/", "test/", "interop/", "dashboard/", "assets/", "docs/", "evidence/", "AGENTS.md", "PRODUCT.md", "DESIGN.md", "README.md", "CONTRIBUTING.md", "SECURITY.md", "LICENSE", "NOTICE"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node bin/kya.mjs demo",
    "benchmark": "node bin/kya.mjs benchmark",
    "probe": "node bin/kya.mjs probe",
    "dashboard": "node scripts/serve.mjs",
    "pack": "node scripts/pack.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:mutations": "node scripts/mutation-check.mjs",
    "adr:index": "node scripts/adr-index.mjs"
  }
}
