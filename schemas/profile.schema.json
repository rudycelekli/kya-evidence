{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kya-evidence:profile:v1",
  "title": "KYA Evidence profile v1",
  "description": "Structural schema only. Runtime validator additionally enforces key fingerprint, temporal ordering, uniqueness by ID, scope relations and canonical JSON resource limits.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "kya.profile/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
          },
          "dimension": {
            "enum": [
              "identity",
              "authority",
              "security",
              "reliability",
              "accountability",
              "operations"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "critical": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "dimension",
          "title",
          "weight",
          "critical"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "title",
    "checks"
  ],
  "additionalProperties": false
}
